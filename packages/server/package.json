{
  "name": "@ukn/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b && { tsc -b --watch --preserveWatchOutput & node --watch dist/index.js; }",
    "prestart": "tsc -b",
    "start": "node dist/index.js",
    "preseed": "tsc -b",
    "seed": "node dist/seed.js",
    "predemo": "tsc -b",
    "demo": "node dist/demo.js",
    "test": "tsc -b && node --test dist/**/*.test.js"
  },
  "dependencies": {
    "@ukn/core": "*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.0.4",
    "fastify": "^5.2.0",
    "zod": "^3.24.1"
  }
}
